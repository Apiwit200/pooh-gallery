---
import Ornament from "@/components/Ornament.astro";
import Tuner from "@/components/Tuner.astro";
import Base from "@/layouts/Base.astro";
import { collections, photos } from "@/lib/photos";
---

<Base title="Channels" description={`All ${collections.length} channels: ${photos.length} photographs grouped by the trips and days they came from.`}>
  <header class="head field-blue">
    <Ornament size="3.5rem" class="head__mark" />
    <h1 class="display head__title" data-scramble="load">Channel guide</h1>
    <p class="lede head__text">{collections.length} channels, {photos.length} photographs. Point at a channel to preview it; open it to watch.</p>
  </header>
  <Tuner list={collections} />
</Base>

<script>
  import "@/scripts/motion";
</script>

<style>
  .head {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding: calc(var(--section) + 2rem) var(--gutter) var(--section);
    text-align: center;
  }
  .head :global(.head__mark) {
    color: var(--color-lime);
  }
  .head__title {
    margin: 0;
    font-size: clamp(4rem, 13vw, 12rem);
  }
  .head__text {
    margin: 0;
    max-width: 38rem;
  }
</style>
