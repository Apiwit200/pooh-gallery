---
import Base from "@/layouts/Base.astro";
import { url } from "@/lib/site";
---

<Base title="Not found" noindex>
  <section class="lost field-blue">
    <h1 class="display lost__title">No signal.</h1>
    <p class="pixel">404 · no signal on this channel</p>
    <p>This page does not exist, or it went off the air.</p>
    <a class="chip" href={url("/")}>Back to the first channel</a>
  </section>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 1.5rem;
    padding: var(--section) var(--gutter);
  }
  .lost__title {
    margin: 0;
    font-size: clamp(4rem, 14vw, 12rem);
  }
  .lost p {
    margin: 0;
  }
</style>
