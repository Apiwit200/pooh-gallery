---
import Photo from "@/components/Photo.astro";
import Starfield from "@/components/Starfield.astro";
import Base from "@/layouts/Base.astro";
import { collection, DEEP_SKY_SLUG, facts, formatDate } from "@/lib/photos";
import { url } from "@/lib/site";

const c = collection(DEEP_SKY_SLUG);
if (!c) throw new Error("The deep sky collection has no public photographs.");
const objects = [...c.photos].sort((a, b) => (a.lightSeconds ?? 0) - (b.lightSeconds ?? 0));
const description = `All ${objects.length} astrophotographs by the photographer, from the Moon to the Andromeda Galaxy, ordered by how far their light travelled.`;
---

<Base title="Beyond the Frame" description={description} image={objects.find((p) => p.title?.startsWith("M31")) ?? c.cover}>
  <div class="sky field-deep">
  <Starfield />
  <header class="head">
    <h1 class="display head__title" data-scramble="load">Beyond the Frame</h1>
    <p class="head__text">
      Channel {c.channel}, the last one, is the night sky. These {objects.length} frames are ordered by how long their light travelled to
      reach the camera: about a second from the Moon, two and a half million years from Andromeda.
    </p>
    <ol class="log pixel" aria-label="Observing log">
      {
        objects.map((p, i) => (
          <li>
            <a href={`#o-${p.id}`}>
              <span>{String(i + 1).padStart(2, "0")}</span>
              <span>{p.title ?? p.name}</span>
              <span>{p.lightTravel}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </header>

  {
    objects.map((p, i) => (
      <section class:list={["object", { "object--tall": p.orientation === "portrait" }]} id={`o-${p.id}`} aria-labelledby={`t-${p.id}`}>
        <div class="object__frame">
          <Photo photo={p} crt sizes={p.orientation === "portrait" ? "(min-width: 64rem) 46vw, 100vw" : "(min-width: 64rem) 70vw, 100vw"} position="center" />
        </div>
        <div class="object__label">
          <h2 id={`t-${p.id}`} class="object__title">{p.title ?? p.name}</h2>
          {p.lightTravel && (
            <p class="object__travel">
              <span class="pixel">Light travel</span>
              {p.lightTravel}
            </p>
          )}
          <p class="pixel object__facts">
            {[`${i + 1} of ${objects.length}`, p.exif.taken ? formatDate(p.exif.taken) : "", ...facts(p)].filter(Boolean).join(" · ")}
          </p>
        </div>
      </section>
    ))
  }

  <footer class="end">
    <p class="end__text">That is as far as the camera has reached so far.</p>
    <a class="chip" href={url("/")}>Back to the first channel</a>
  </footer>
  </div>
</Base>

<script>
  import "@/scripts/motion";
</script>

<style>
  :global(body) {
    position: relative;
  }
  .sky {
    position: relative;
    isolation: isolate;
  }
  .sky > :global(.starfield) {
    position: fixed;
  }
  .head {
    min-height: 100svh;
    padding: calc(var(--section) + 2rem) var(--gutter) 4rem;
    display: grid;
    align-content: end;
    gap: 1.75rem;
    color: var(--color-white);
  }
  .head__trail {
    margin: 0;
    opacity: 0.78;
  }
  .head__trail a {
    text-decoration: none;
  }
  .head__title {
    margin: 0;
    font-size: clamp(4rem, 13vw, 12rem);
    margin-left: -0.04em;
    font-weight: 400;
  }
  .head__text {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.125rem, 0.6vw + 1rem, 1.375rem);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .log {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    max-width: 56rem;
    border-top: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
  }
  .log a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-white) 10%, transparent);
    text-decoration: none;
    color: color-mix(in oklab, var(--color-white) 72%, transparent);
    transition: color 0.3s;
  }
  .log a:hover,
  .log a:focus-visible {
    color: var(--color-white);
  }
  @media (max-width: 40rem) {
    .log a {
      grid-template-columns: 2rem 1fr;
    }
    .log a span:last-child {
      grid-column: 2;
      opacity: 0.8;
    }
  }

  .object {
    min-height: 100svh;
    padding: 4rem var(--gutter);
    display: grid;
    align-content: center;
    gap: 2rem;
    color: var(--color-white);
  }
  .object__frame {
    display: flex;
    justify-content: center;
  }
  .object__frame :global(.frame) {
    max-height: 82svh;
    width: auto;
    max-width: 100%;
    background-color: var(--color-deep) !important;
  }
  .object__frame :global(.frame img) {
    object-fit: contain;
  }
  .object__label {
    display: grid;
    gap: 0.75rem;
    max-width: 30rem;
  }
  .object__index {
    margin: 0;
    opacity: 0.72;
  }
  .object__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 4.4vw, 4.25rem);
    line-height: 0.9;
    text-wrap: balance;
  }
  .object__travel {
    margin: 0;
    display: grid;
    gap: 0.25rem;
    font-size: 1.25rem;
  }
  .object__travel .pixel {
    color: var(--color-lime);
  }
  .object__facts {
    margin: 0;
    opacity: 0.78;
  }
  @media (min-width: 64rem) {
    .object {
      grid-template-columns: 1fr 20rem;
      align-items: end;
    }
    .object--tall {
      grid-template-columns: 1fr 1fr;
    }
    .object--tall .object__label {
      align-self: center;
    }
  }

  .end {
    min-height: 70svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2rem;
    padding: var(--section) var(--gutter);
    text-align: center;
    color: var(--color-white);
  }
  .end__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.9;
    max-width: 20ch;
    text-wrap: balance;
  }
</style>
