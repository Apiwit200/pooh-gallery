---
import Ornament from "@/components/Ornament.astro";
import Photo from "@/components/Photo.astro";
import Starfield from "@/components/Starfield.astro";
import TestCard from "@/components/TestCard.astro";
import TossTable from "@/components/TossTable.astro";
import Tuner from "@/components/Tuner.astro";
import Base from "@/layouts/Base.astro";
import { asset, collection, collectionHref, collections, DEEP_SKY_SLUG, home, photos } from "@/lib/photos";
import { site, url } from "@/lib/site";

const base = import.meta.env.BASE_URL;
const [inlineA, inlineB] = home.inline;
const years = photos.flatMap((p) => (p.exif.taken ? [Number(p.exif.taken.slice(0, 4))] : []));
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : "";
const channels = collections.filter((c) => c.slug !== DEEP_SKY_SLUG);
const deep = collection(DEEP_SKY_SLUG);
const inlineIds = new Set(home.inline.map((p) => p.id));
const table = home.featured.filter((p) => !inlineIds.has(p.id) && p.collection !== DEEP_SKY_SLUG).slice(0, 10);
const trail = home.trail.filter((p) => p.collection !== DEEP_SKY_SLUG).slice(0, 10);
const jsonld = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: site.title,
  description: site.description,
  author: { "@type": "Person", name: site.photographer },
};
---

<Base jsonld={jsonld}>
  <section class="open field-blue" data-trail aria-labelledby="title">
    <div class="open__trail" aria-hidden="true">
      {
        trail.map((p) => (
          <img
            class="open__flung"
            data-trail-item
            src={asset(base, p, 480)}
            alt=""
            width={p.width}
            height={p.height}
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </div>

    <div class="open__stack">
      <Ornament size="clamp(3.5rem, 6vw, 5.5rem)" class="open__mark" />
      <h1 id="title" class="display open__title">
        <span class="open__line">Light Falls</span>
        <span class="open__line">
          {photos.length} frames
          {inlineA && <img class="open__inline" src={asset(base, inlineA, 480)} alt="" width="96" height="64" style={`object-position:${Math.round(inlineA.focus[0] * 100)}% ${Math.round(inlineA.focus[1] * 100)}%`} />}
          from the road
        </span>
        <span class="open__line">
          to
          {inlineB && <img class="open__inline" src={asset(base, inlineB, 480)} alt="" width="96" height="64" style={`object-position:${Math.round(inlineB.focus[0] * 100)}% ${Math.round(inlineB.focus[1] * 100)}%`} />}
          Andromeda
        </span>
      </h1>
      <p class="pixel open__by">Photographs by {site.photographer}{span && `, ${span}`} · {collections.length} channels</p>
      <ul class="open__chips" aria-label="Channels">
        {channels.slice(0, 6).map((c) => (
          <li>
            <a class="chip" href={url(collectionHref(c.slug))}>{c.title}</a>
          </li>
        ))}
      </ul>
      <Ornament size="clamp(2rem, 3.5vw, 3rem)" kind="star" class="open__mark" />
    </div>

    <p class="pixel open__corner open__corner--left">
      Light Falls<br />Channel guide inside
    </p>
    <div class="open__tiles">
      <a class="open__tile open__tile--lime" href="#transmission" aria-label="Scroll to the transmission">
        <Ornament size="60%" />
      </a>
    </div>
  </section>

  <section id="transmission" class="say field-blue" aria-label="About this site">
    <p class="lede say__text" data-gather>
      These are photographs from roads, zoos, cafés, beaches and temples in Thailand and Taiwan, and from the sky above
      them. They play here as channels. Change the channel, stay on one, or open the whole archive and let it run.
    </p>
    <p class="pixel say__hint">Hover any photograph to clear the screen in front of it.</p>
    <div class="say__card">
      <TestCard photo={home.finale} caption="Please stand by · Light Falls" />
    </div>
  </section>

  <Tuner list={channels} heading={`Channel guide · ${channels.length} channels and the night sky`} headingId="guide" />

  <section class="tossed field-blue" aria-labelledby="tossed-title">
    <header class="tossed__head">
      <h2 id="tossed-title" class="display tossed__title" data-scramble>Prints on the table</h2>
      <p class="pixel">Drag a print to move it. Click to see it whole.</p>
    </header>
    <TossTable photos={table} label="Selected photographs, scattered like prints" />
  </section>

  {
    deep && (
      <section class="sky field-deep" aria-labelledby="sky-title">
        <Starfield />
        <h2 id="sky-title" class="display sky__title" data-scramble>
          Beyond the frame
        </h2>
        <p class="sky__text">
          Channel {deep.channel}, the last one: the Moon, the Sun, Jupiter, the Pleiades, Orion and the Andromeda
          Galaxy. {deep.photos.length} frames ordered by how long their light travelled; the five farthest are here.
        </p>
        <div class="sky__row">
          {[...deep.photos]
            .sort((a, b) => (a.lightSeconds ?? 0) - (b.lightSeconds ?? 0))
            .slice(-5)
            .map((p) => (
              <Photo photo={p} ratio="3 / 4" sizes="(min-width: 64rem) 18vw, 40vw" />
            ))}
        </div>
        <a class="chip" href={url("/deep-sky/")}>Tune in to the deep sky</a>
      </section>
    )
  }

  <section class="end field-lime" aria-labelledby="end-title">
    <Ornament size="clamp(4rem, 8vw, 7rem)" />
    <h2 id="end-title" class="display end__title">End of transmission</h2>
    <nav class="end__links" aria-label="Keep watching">
      <a class="chip chip--blue" href={url("/index/")}>Every channel</a>
      <a class="chip chip--blue" href={url("/archive/")}>The whole archive</a>
      <a class="chip chip--blue" href={url("/about/")}>About</a>
    </nav>
    <p class="pixel end__credit">© {new Date().getFullYear()} {site.photographer}</p>
  </section>
</Base>

<script>
  import "@/scripts/motion";
</script>

<style>
  .open {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 5.5rem var(--gutter) 7rem;
    overflow: clip;
    text-align: center;
  }
  .open__trail {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .open__flung {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(9rem, 16vw, 15rem);
    height: auto;
    visibility: hidden;
    box-shadow: 0 0 0 6px var(--color-white);
  }
  .open__stack {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    pointer-events: none;
  }
  .open__stack a {
    pointer-events: auto;
  }
  .open__mark {
    color: var(--color-lime);
  }
  .open__title {
    margin: 0;
    font-size: clamp(3.25rem, 9vw, 9.5rem);
    line-height: 0.92;
  }
  .open__line {
    display: block;
  }
  .open__inline {
    display: inline-block;
    width: 1.4em;
    height: 0.82em;
    object-fit: cover;
    vertical-align: -0.04em;
    margin-inline: 0.06em;
    box-shadow: 0 0 0 3px var(--color-lime);
  }
  .open__by {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
  }
  .open__chips {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    max-width: 40rem;
  }
  .open__corner {
    position: absolute;
    z-index: 1;
    bottom: 1.5rem;
    margin: 0;
    text-align: left;
  }
  .open__corner--left {
    left: var(--gutter);
  }
  .open__tiles {
    position: absolute;
    z-index: 1;
    right: var(--gutter);
    bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
  }
  .open__tile {
    display: grid;
    place-items: center;
    width: clamp(4.5rem, 8vw, 7rem);
    aspect-ratio: 1;
    overflow: hidden;
  }
  .open__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .open__tile--lime {
    background: var(--color-lime);
    color: var(--color-ink);
  }
  .open__tile--lime:hover {
    background: var(--color-white);
  }
  @media (max-width: 40rem) {
    .open__corner {
      display: none;
    }
    .open__tiles {
      right: 50%;
      translate: 50% 0;
    }
  }

  .say {
    padding: var(--section) var(--gutter);
    display: grid;
    gap: 2rem;
    overflow: clip;
  }
  .say__text {
    margin: 0;
    max-width: 44rem;
  }
  .say__hint {
    margin: 0;
    color: var(--color-lime);
  }
  .say__card {
    width: min(100%, 30rem);
  }
  @media (min-width: 64rem) {
    .say {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
      column-gap: 4rem;
    }
    .say__card {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-self: end;
    }
  }

  .tossed {
    padding: var(--section) var(--gutter);
    overflow: clip;
  }
  .tossed__head {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    margin-bottom: 2rem;
  }
  .tossed__head p {
    margin: 0;
  }
  .tossed__title {
    margin: 0;
    font-size: clamp(3rem, 8vw, 8rem);
  }
  @media (max-width: 47.99rem) {
    .tossed {
      padding-inline: 0;
    }
  }

  .sky {
    position: relative;
    isolation: isolate;
    padding: var(--section) var(--gutter);
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
    overflow: clip;
  }
  .sky__title {
    margin: 0;
    font-size: clamp(3.5rem, 11vw, 11rem);
  }
  .sky__text {
    margin: 0;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.45;
  }
  .sky__row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.5vw, 1rem);
    margin-block: 1.5rem;
  }
  @media (max-width: 47.99rem) {
    .sky__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sky__row > :global(.frame:nth-child(n + 5)) {
      display: none;
    }
  }

  .end {
    min-height: 80svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2rem;
    padding: var(--section) var(--gutter);
    text-align: center;
  }
  .end :global(.ornament) {
    color: var(--color-blue);
  }
  .end__title {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 10rem);
    color: var(--color-blue);
  }
  .end__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .end__credit {
    margin: 0;
  }
</style>
