---
import Grid from "@/components/Grid.astro";
import Photo from "@/components/Photo.astro";
import Base from "@/layouts/Base.astro";
import { compose } from "@/lib/compose";
import { collections, DEEP_SKY_SLUG, formatDate, formatEv, type Collection } from "@/lib/photos";
import { url } from "@/lib/site";

export function getStaticPaths() {
  return collections
    .filter((c) => c.slug !== DEEP_SKY_SLUG)
    .map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Collection };
const order = collections.filter((x) => x.slug !== DEEP_SKY_SLUG);
const i = order.indexOf(c);
const higher = order[i - 1];
const deeper = order[i + 1] ?? collections.find((x) => x.slug === DEEP_SKY_SLUG);
const href = (x: Collection) => url(x.slug === DEEP_SKY_SLUG ? "/deep-sky/" : `/c/${x.slug}/`);

const portraits = c.photos.filter((p) => p.orientation === "portrait").length;
const portraitLed = portraits > c.photos.length / 2;
const blocks = compose(c.sequence);
const cameras = [...new Set(c.photos.map((p) => p.exif.model).filter(Boolean))];
const when = c.dates
  ? c.dates.from.slice(0, 10) === c.dates.to.slice(0, 10)
    ? formatDate(c.dates.from)
    : `${formatDate(c.dates.from)} – ${formatDate(c.dates.to)}`
  : "";
const intro =
  c.intro ||
  `${c.photos.length} photographs${when ? `, ${when}` : ""}. ${c.stratum.name} on the scale${c.ev ? `, from ${formatEv(c.ev.top)} down to ${formatEv(c.ev.bottom)}` : ""}.`;
const ground = c.stratum.key;
---

<Base title={c.title} description={intro} image={c.cover} preload={c.cover} ground={ground}>
  <article>
    <header class:list={["head", { "head--portrait": c.cover.orientation === "portrait" }]} data-ground-zone={ground} data-nav-over={c.cover.orientation === "portrait" ? undefined : true}>
      <Photo
        photo={c.cover}
        eager
        class="head__cover"
        ratio={c.cover.orientation === "portrait" ? undefined : "auto"}
        sizes={c.cover.orientation === "portrait" ? "(min-width: 48rem) 45vw, 100vw" : "100vw"}
        transitionName={`cover-${c.slug}`}
      />
      <div class="head__text">
        <h1 class="display head__title">{c.title}</h1>
        <p class="head__intro">{intro}</p>
        <dl class="mono head__facts">
          <div><dt>Stratum</dt><dd>{c.stratum.name}</dd></div>
          <div><dt>Frames</dt><dd>{c.photos.length}</dd></div>
          {c.ev && <div><dt>Light</dt><dd>{formatEv(c.ev.top)} → {formatEv(c.ev.bottom)}</dd></div>}
          {when && <div><dt>Made</dt><dd>{when}</dd></div>}
          {cameras.length > 0 && <div><dt>Camera</dt><dd>{cameras.join(", ")}</dd></div>}
        </dl>
      </div>
    </header>

    {
      blocks.length > 0 && (
        <section class:list={["sequence", { "sequence--portrait": portraitLed }]} aria-label="Selected frames">
          {blocks.map((b) => (
            <div class:list={["block", `block--${b.kind}`, b.kind === "offset" && `block--${b.side}`]}>
              {b.kind === "full" && <Photo photo={b.photo} sizes="100vw" />}
              {b.kind === "offset" && <Photo photo={b.photo} sizes="(min-width: 64rem) 58vw, 100vw" />}
              {b.kind === "pair" && b.photos.map((p) => <Photo photo={p} sizes="(min-width: 48rem) 40vw, 100vw" />)}
              {b.kind === "strip" && b.photos.map((p) => <Photo photo={p} sizes="(min-width: 48rem) 45vw, 100vw" />)}
              {b.kind === "quiet" && <Photo photo={b.photo} sizes="(min-width: 48rem) 26vw, 60vw" />}
            </div>
          ))}
        </section>
      )
    }

    <section class="all" aria-labelledby="all">
      <h2 id="all" class="all__title">All {c.photos.length} frames<span class="mono"> · in the order they were made</span></h2>
      <Grid photos={c.photos} label={`All photographs in ${c.title}`} row={portraitLed ? "clamp(12rem, 26vw, 22rem)" : undefined} />
    </section>

    <nav class="neighbours" aria-label="Neighbouring collections">
      {
        higher && (
          <a href={href(higher)} class="neighbour">
            <span class="mono">Higher · {higher.ev ? formatEv(higher.ev.median) : ""}</span>
            <span class="display neighbour__title">{higher.title}</span>
          </a>
        )
      }
      {
        deeper && (
          <a href={href(deeper)} class="neighbour neighbour--deeper">
            <span class="mono">Deeper · {deeper.ev ? formatEv(deeper.ev.median) : "beyond the scale"}</span>
            <span class="display neighbour__title">{deeper.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .head {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: end;
    color: #f4f1ea;
  }
  .head :global(.head__cover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .head::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 12 14 / 0.62), transparent 55%), linear-gradient(to bottom, rgb(8 12 14 / 0.35), transparent 20%);
    pointer-events: none;
  }
  .head__text {
    position: relative;
    z-index: 1;
    padding: 0 calc(var(--gutter) + var(--rail)) clamp(2rem, 6vh, 4rem) var(--gutter);
    display: grid;
    gap: 1.25rem;
  }
  .head__trail {
    margin: 0;
    opacity: 0.8;
  }
  .head__trail a {
    text-decoration: none;
  }
  .head__trail a:hover {
    text-decoration: underline;
  }
  .head__title {
    margin: 0;
    font-size: clamp(3.75rem, 12vw, 11rem);
    margin-left: -0.04em;
  }
  .head__intro {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.0625rem, 0.5vw + 0.95rem, 1.3125rem);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .head__facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
  }
  .head__facts dt {
    opacity: 0.78;
  }
  .head__facts dd {
    margin: 0;
  }

  .head--portrait {
    color: var(--fg);
    grid-template-columns: 1fr;
    align-content: start;
    padding-top: var(--nav-h);
  }
  .head--portrait::after {
    display: none;
  }
  .head--portrait :global(.head__cover) {
    position: relative;
    height: auto;
    max-height: 88svh;
  }
  .head--portrait .head__text {
    padding-top: 2rem;
  }
  @media (min-width: 48rem) {
    .head--portrait {
      grid-template-columns: 1fr 45vw;
      align-items: end;
      padding-top: 0;
    }
    .head--portrait :global(.head__cover) {
      grid-column: 2;
      grid-row: 1;
      max-height: 100svh;
      height: 100svh;
      width: 100%;
    }
    .head--portrait .head__text {
      grid-column: 1;
      grid-row: 1;
      padding-right: 2rem;
    }
  }

  .sequence {
    padding-block: var(--section);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3.5rem, 10vh, 7rem);
  }
  .block {
    padding-inline: var(--gutter) calc(var(--gutter) + var(--rail));
  }
  .block--full {
    padding-inline: 0 var(--rail);
  }
  .block--full :global(.frame) {
    max-height: 100svh;
    margin-inline: auto;
  }
  .block--offset :global(.frame) {
    width: min(100%, 58rem);
    max-width: 62vw;
  }
  .block--right {
    display: flex;
    justify-content: flex-end;
  }
  .block--left {
    padding-left: clamp(var(--gutter), 9vw, 10rem);
  }
  .block--pair,
  .block--strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(0.75rem, 2.5vw, 2.5rem);
    align-items: start;
  }
  .block--pair :global(.frame:nth-child(2)) {
    margin-top: clamp(3rem, 14vh, 10rem);
  }
  .block--strip {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .block--quiet {
    display: flex;
    justify-content: center;
  }
  .block--quiet :global(.frame) {
    width: clamp(11rem, 24vw, 22rem);
  }
  .sequence--portrait .block--pair {
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
    padding-right: clamp(var(--gutter), 14vw, 14rem);
  }
  @media (max-width: 48rem) {
    .block--offset :global(.frame) {
      max-width: none;
      width: 88%;
    }
    .block--left {
      padding-left: var(--gutter);
    }
  }

  .all {
    padding: var(--section) calc(var(--gutter) + var(--rail)) var(--section) var(--gutter);
    border-top: 1px solid var(--hair);
  }
  .all__title {
    margin: 0 0 2rem;
    font-size: clamp(1.5rem, 2vw + 0.8rem, 2.5rem);
    font-variation-settings: "wdth" 80;
    font-weight: 540;
    letter-spacing: -0.02em;
  }
  .all__title .mono {
    font-weight: 400;
    color: var(--fg-dim);
    letter-spacing: 0.02em;
  }

  .neighbours {
    display: grid;
    border-top: 1px solid var(--hair);
  }
  .neighbour {
    display: grid;
    gap: 0.75rem;
    padding: clamp(2.5rem, 8vh, 5rem) calc(var(--gutter) + var(--rail)) clamp(2.5rem, 8vh, 5rem) var(--gutter);
    text-decoration: none;
    transition: background-color 0.5s var(--ease-out-expo);
  }
  .neighbour:hover {
    background: color-mix(in oklab, var(--fg) 6%, transparent);
  }
  .neighbour__title {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
  }
  .neighbour--deeper {
    text-align: right;
    border-top: 1px solid var(--hair);
  }
  @media (min-width: 48rem) {
    .neighbours {
      grid-template-columns: 1fr 1fr;
    }
    .neighbour--deeper {
      border-top: 0;
      border-left: 1px solid var(--hair);
      grid-column: 2;
    }
  }
</style>
