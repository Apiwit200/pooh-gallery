---
import Grid from "@/components/Grid.astro";
import Ornament from "@/components/Ornament.astro";
import Photo from "@/components/Photo.astro";
import Base from "@/layouts/Base.astro";
import { compose } from "@/lib/compose";
import { channelLabel, collectionHref, collections, DEEP_SKY_SLUG, formatDate, type Collection } from "@/lib/photos";
import { url } from "@/lib/site";

export function getStaticPaths() {
  return collections.filter((c) => c.slug !== DEEP_SKY_SLUG).map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Collection };
const i = collections.indexOf(c);
const prev = collections[i - 1];
const next = collections[i + 1];
const blocks = compose(c.sequence);
const cameras = [...new Set(c.photos.map((p) => p.exif.model).filter(Boolean))];
const when = c.dates
  ? c.dates.from.slice(0, 10) === c.dates.to.slice(0, 10)
    ? formatDate(c.dates.from)
    : `${formatDate(c.dates.from)} – ${formatDate(c.dates.to)}`
  : "";
const intro = c.intro || `${c.photos.length} photographs${when ? `, ${when}` : ""}.`;
---

<Base title={c.title} description={intro} image={c.cover} preload={c.cover} preloadSizes="(min-width: 64rem) 60vw, 100vw">
  <article>
    <header class="head field-blue">
      <div class="head__text">
        <h1 class="display head__title" data-scramble="load">{c.title}</h1>
        <p class="lede head__intro">{intro}</p>
        <dl class="pixel head__facts">
          <div><dt>Channel</dt><dd>{channelLabel(c.channel)}</dd></div>
          <div><dt>Frames</dt><dd>{c.photos.length}</dd></div>
          {when && <div><dt>On air</dt><dd>{when}</dd></div>}
          {cameras.length > 0 && <div><dt>Camera</dt><dd>{cameras.join(", ")}</dd></div>}
        </dl>
      </div>
      <div class="head__screen">
        <Photo photo={c.cover} eager crt sizes="(min-width: 64rem) 60vw, 100vw" transitionName={`cover-${c.slug}`} />
      </div>
    </header>

    {
      blocks.length > 0 && (
        <section class="sequence field-paper" aria-label="Selected frames">
          {blocks.map((b, n) => (
            <div class:list={["block", `block--${b.kind}`, b.kind === "offset" && `block--${b.side}`]} style={`--tilt:${((n * 37) % 7) - 3}deg`}>
              {b.kind === "full" && <Photo photo={b.photo} crt sizes="(min-width: 64rem) 80vw, 100vw" />}
              {b.kind === "offset" && <Photo photo={b.photo} crt sizes="(min-width: 64rem) 55vw, 100vw" />}
              {b.kind === "pair" && b.photos.map((p) => <Photo photo={p} sizes="(min-width: 48rem) 40vw, 100vw" />)}
              {b.kind === "strip" && b.photos.map((p) => <Photo photo={p} sizes="(min-width: 48rem) 30vw, 100vw" />)}
              {b.kind === "quiet" && <Photo photo={b.photo} sizes="(min-width: 48rem) 26vw, 60vw" />}
            </div>
          ))}
        </section>
      )
    }

    <section class="all field-paper" aria-labelledby="all">
      <h2 id="all" class="all__title">
        <span class="display">All {c.photos.length} frames</span>
        <span class="pixel">in the order they were made</span>
      </h2>
      <Grid photos={c.photos} label={`All photographs in ${c.title}`} />
    </section>

    <nav class="dial field-lime" aria-label="Change channel">
      {
        prev && (
          <a href={url(collectionHref(prev.slug))} class="dial__link">
            <span class="display dial__title">{prev.title}</span>
            <span class="pixel dial__meta"><Ornament kind="arrow-left" size="0.75rem" /> {channelLabel(prev.channel)}</span>
          </a>
        )
      }
      {
        next && (
          <a href={url(collectionHref(next.slug))} class="dial__link dial__link--next">
            <span class="display dial__title">{next.title}</span>
            <span class="pixel dial__meta dial__meta--next">{channelLabel(next.channel)} <Ornament kind="arrow-right" size="0.75rem" /></span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  import "@/scripts/motion";
</script>

<style>
  .head {
    display: grid;
    gap: 2.5rem;
    padding: 6rem var(--gutter) var(--section);
    align-items: end;
  }
  .head__text {
    display: grid;
    gap: 1.5rem;
  }
  .head__title {
    margin: 0;
    font-size: clamp(3.75rem, 11vw, 10rem);
  }
  .head__intro {
    margin: 0;
    max-width: 36rem;
  }
  .head__facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }
  .head__facts dt {
    color: var(--color-lime);
  }
  .head__facts dd {
    margin: 0;
  }
  .head__screen {
    padding: 0.6rem;
    background: var(--color-ink);
    box-shadow: 0 0 0 1px var(--hair);
  }
  @media (min-width: 64rem) {
    .head {
      grid-template-columns: 1fr 1.35fr;
      min-height: 100svh;
    }
  }

  .sequence {
    padding-block: var(--section);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 9vh, 6rem);
  }
  .block {
    padding-inline: var(--gutter);
  }
  .block :global(.frame) {
    rotate: var(--tilt);
    padding: 0;
    box-shadow: 0 0 0 clamp(0.4rem, 0.8vw, 0.7rem) var(--color-white), 0 14px 30px -14px rgb(3 0 15 / 0.45);
    transition: rotate 0.35s var(--ease-out-expo);
  }
  .block :global(.frame:hover) {
    rotate: 0deg;
  }
  .block--full :global(.frame) {
    width: min(100%, 72rem);
    margin-inline: auto;
  }
  .block--offset :global(.frame) {
    width: min(100%, 52rem);
  }
  .block--right {
    display: flex;
    justify-content: flex-end;
  }
  .block--left {
    padding-left: clamp(var(--gutter), 9vw, 10rem);
  }
  .block--pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 3rem);
    align-items: start;
  }
  .block--strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1rem, 3vw, 3rem);
    align-items: start;
  }
  .block--pair :global(.frame:nth-child(2)) {
    margin-top: clamp(2rem, 10vh, 7rem);
    rotate: calc(var(--tilt) * -1);
  }
  .block--quiet {
    display: flex;
    justify-content: flex-end;
    padding-right: clamp(var(--gutter), 12vw, 12rem);
  }
  .block--quiet :global(.frame) {
    width: clamp(11rem, 24vw, 22rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .block :global(.frame) {
      transition: none;
    }
  }

  .all {
    padding: var(--section) var(--gutter);
    border-top: 1px solid var(--hair);
  }
  .all__title {
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    font-weight: 400;
  }
  .all__title .display {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-blue);
  }

  .dial {
    display: grid;
  }
  .dial__link {
    display: grid;
    gap: 0.5rem;
    padding: clamp(2.5rem, 8vh, 5rem) var(--gutter);
    text-decoration: none;
  }
  .dial__link:hover {
    background: var(--color-white);
  }
  .dial__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dial__meta--next {
    justify-content: flex-end;
  }
  .dial__title {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    color: var(--color-blue);
  }
  .dial__link--next {
    text-align: right;
    border-top: 1px solid var(--hair);
  }
  @media (min-width: 48rem) {
    .dial {
      grid-template-columns: 1fr 1fr;
    }
    .dial__link--next {
      grid-column: 2;
      border-top: 0;
      border-left: 1px solid var(--hair);
    }
  }
</style>
