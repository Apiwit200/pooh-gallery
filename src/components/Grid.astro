---
import Photo from "@/components/Photo.astro";
import type { Photo as P } from "@/lib/photos";

interface Props {
  photos: P[];
  /** Target row height; rows justify around it using each frame's real aspect ratio. */
  row?: string | undefined;
  label?: string;
  /** How many leading frames load eagerly (they sit above the fold). */
  eager?: number;
}
const { photos, row = "clamp(9rem, 22vw, 17rem)", label, eager = 0 } = Astro.props;
---

<ul class="grid" style={`--row:${row}`} aria-label={label}>
  {
    photos.map((p, i) => (
      <li style={`--r:${(p.width / p.height).toFixed(4)}`}>
        <Photo photo={p} eager={i < eager} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw" />
      </li>
    ))
  }
  <li class="grid__filler" aria-hidden="true"></li>
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.375rem, 0.8vw, 0.75rem);
  }
  .grid > li {
    flex: var(--r) 1 calc(var(--r) * var(--row));
    content-visibility: auto;
    contain-intrinsic-size: auto calc(var(--row));
  }
  .grid > li > :global(.frame) {
    height: 100%;
    width: 100%;
  }
  .grid > li > :global(.frame img) {
    transition:
      opacity 0.7s var(--ease-out-expo),
      transform 0.9s var(--ease-out-expo),
      filter 0.6s;
  }
  .grid > li > :global(.frame:hover img) {
    transform: scale(1.025);
  }
  .grid:has(:global(.frame:hover)) > li > :global(.frame:not(:hover) img) {
    filter: saturate(0.35) brightness(0.86);
  }
  .grid__filler {
    flex: 999 1 0 !important;
    content-visibility: visible !important;
  }
  @media (max-width: 30rem) {
    .grid {
      --row: 7.5rem !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grid > li > :global(.frame img) {
      transition: none;
    }
    .grid > li > :global(.frame:hover img) {
      transform: none;
    }
  }
</style>
