<canvas class="starfield" data-starfield aria-hidden="true"></canvas>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  const canvases = document.querySelectorAll<HTMLCanvasElement>("[data-starfield]");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  canvases.forEach((canvas, n) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    let seed = 1979 + n;
    const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
    let stars: { x: number; y: number; r: number; a: number; tw: number; ph: number }[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    let visible = false;

    const resize = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed = 1979 + n;
      const count = Math.min(900, Math.round((w * h) / 2600));
      stars = Array.from({ length: count }, () => {
        const big = rand() > 0.985;
        return { x: rand() * w, y: rand() * h, r: big ? 0.9 + rand() * 0.6 : 0.25 + rand() * 0.55, a: 0.25 + rand() * 0.6, tw: 0.4 + rand() * 1.2, ph: rand() * 6.28 };
      });
      draw(0);
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      const drift = (scrollY * 0.02) % h;
      for (const s of stars) {
        const a = still ? s.a : s.a * (0.75 + 0.25 * Math.sin(s.ph + (t / 1000) * s.tw));
        const y = (s.y - drift * s.r + h) % h;
        ctx.globalAlpha = a;
        ctx.fillStyle = "#dfe6ef";
        ctx.beginPath();
        ctx.arc(s.x, y, s.r, 0, 6.2832);
        ctx.fill();
      }
    };

    const loop = (t: number) => {
      draw(t);
      if (visible && !still) raf = requestAnimationFrame(loop);
    };

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible && !still) raf = requestAnimationFrame(loop);
    }).observe(canvas);
  });
</script>
