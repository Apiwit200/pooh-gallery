---
import Ornament from "@/components/Ornament.astro";
import { channelLabel, collectionHref, collections } from "@/lib/photos";
import { site, url } from "@/lib/site";

const current = Astro.url.pathname;
const links = [
  { href: url("/index/"), label: "Channels" },
  { href: url("/archive/"), label: "Archive" },
  { href: url("/deep-sky/"), label: "Deep sky" },
  { href: url("/about/"), label: "About" },
];
const isCurrent = (href: string) => current === href || current.startsWith(href);
---

<header class="pill">
  <a class="pill__mark" href={url("/")} aria-current={current === url("/") ? "page" : undefined}>
    <Ornament size="1.1rem" />
    <span>{site.title}</span>
  </a>
  <nav aria-label="Primary" class="pill__links pixel">
    {links.map((l) => <a class="trace" href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>)}
  </nav>
  <button class="pill__menu" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
    <span class="sr-only">Open the channel list</span>
    <svg viewBox="0 0 16 10" width="18" height="12" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 0h16v2H0zM0 4h16v2H0zM0 8h16v2H0z" fill="currentColor"></path></svg>
  </button>
</header>

<dialog id="menu" class="menu field-blue" aria-label="Channels">
  <div class="menu__bar">
    <span class="pixel">Now showing · {collections.length} channels</span>
    <button type="button" class="chip" data-menu-close>Close</button>
  </div>
  <nav aria-label="Channels">
    <ol class="menu__list">
      {
        collections.map((c) => (
          <li>
            <a href={url(collectionHref(c.slug))}>
              <span class="pixel menu__ch">{channelLabel(c.channel)}</span>
              <span class="display menu__title">{c.title}</span>
              <span class="pixel menu__count">{c.photos.length}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <ul class="menu__more">
      {[{ href: url("/"), label: "Home" }, ...links].map((l) => (
        <li>
          <a class="chip chip--ghost" href={l.href}>{l.label}</a>
        </li>
      ))}
      {(site.email || site.links.length > 0) && (
        <li>
          <a class="chip chip--ghost" href={url("/contact/")}>Contact</a>
        </li>
      )}
    </ul>
  </nav>
</dialog>

<style>
  .pill {
    position: fixed;
    z-index: 1500;
    top: 0.75rem;
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    padding: 0.35rem 0.4rem 0.35rem 0.75rem;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 0 0 1px rgb(18 13 43 / 0.12), 0 6px 18px -8px rgb(3 0 15 / 0.45);
    border-radius: 4px;
    max-width: calc(100vw - 2 * var(--gutter));
  }
  .pill__mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-blue);
  }
  .pill__mark span {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .pill__links {
    display: none;
    gap: 1.25rem;
  }
  .pill__links a {
    padding-block: 0.4rem;
  }
  .pill__menu {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.25rem;
    border: 0;
    background: var(--color-blue);
    color: var(--color-white);
    border-radius: 2px;
    cursor: pointer;
  }
  .pill__menu:hover {
    background: var(--color-ink);
  }
  @media (min-width: 56rem) {
    .pill__links {
      display: flex;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) 3rem;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 0.45s steps(9),
      display 0.45s allow-discrete,
      overlay 0.45s allow-discrete;
  }
  .menu[open] {
    clip-path: inset(0 0 0 0);
  }
  @starting-style {
    .menu[open] {
      clip-path: inset(0 0 100% 0);
    }
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1rem;
    background: var(--field);
  }
  .menu__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .menu__list a {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
  }
  .menu__title {
    font-size: clamp(2.25rem, 6vw, 4.75rem);
  }
  .menu__ch,
  .menu__count {
    color: var(--color-lime);
  }
  .menu__list a:hover .menu__title,
  .menu__list a:focus-visible .menu__title {
    color: var(--color-lime);
  }
  .menu__more {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu {
      transition: none;
    }
  }
</style>

<script>
  const menu = document.getElementById("menu") as HTMLDialogElement | null;
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.closest("[data-menu-open]")) menu?.showModal();
    else if (t.closest("[data-menu-close]") || (t.closest("#menu a") && menu?.open)) menu?.close();
  });
</script>
