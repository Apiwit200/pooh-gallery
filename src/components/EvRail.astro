---
import { EV_SCALE } from "@/lib/photos";

const span = EV_SCALE.top - EV_SCALE.bottom;
const ticks = Array.from({ length: span + 1 }, (_, i) => EV_SCALE.top - i);
const pos = (ev: number) => ((EV_SCALE.top - ev) / span) * 100;
---

<aside class="rail" aria-hidden="true" data-rail data-top={EV_SCALE.top} data-bottom={EV_SCALE.bottom}>
  <div class="rail__scale">
    {
      ticks.map((ev) => (
        <span class:list={["rail__tick", { "rail__tick--major": ev % 4 === 0 }]} style={`top:${pos(ev)}%`}>
          {ev % 4 === 0 && <span class="rail__num mono">{ev < 0 ? `−${-ev}` : ev}</span>}
        </span>
      ))
    }
    <span class="rail__beyond mono">∞</span>
    <span class="rail__marker" data-rail-marker></span>
  </div>
  <p class="rail__reading mono" data-rail-reading>EV</p>
</aside>

<style>
  .rail {
    position: fixed;
    z-index: 30;
    top: calc(var(--nav-h) + 1rem);
    bottom: 3.5rem;
    right: 0;
    width: var(--rail);
    pointer-events: none;
    color: var(--fg);
    transition: color 0.9s var(--ease-out-expo);
  }
  .rail__scale {
    position: absolute;
    inset: 0 0 2.75rem 0;
    border-left: 1px solid var(--hair);
    margin-left: 0.25rem;
  }
  .rail__tick {
    position: absolute;
    left: 0;
    width: 0.375rem;
    height: 1px;
    background: var(--hair);
  }
  .rail__tick--major {
    width: 0.75rem;
  }
  .rail__num {
    position: absolute;
    left: 1.1rem;
    top: -0.45rem;
    font-size: 0.625rem;
    color: var(--fg-dim);
    opacity: 0.55;
  }
  .rail__beyond {
    position: absolute;
    left: 1.1rem;
    bottom: -1.6rem;
    font-size: 0.75rem;
    opacity: 0.35;
  }
  .rail__marker {
    position: absolute;
    left: -0.25rem;
    top: 0;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    transform: translateY(var(--marker, -10px));
    transition: transform 0.9s var(--ease-out-expo), opacity 0.4s;
  }
  .rail__reading {
    position: absolute;
    right: 0.5rem;
    bottom: 0;
    width: max-content;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .rail__num {
      display: none;
    }
    .rail {
      width: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail__marker {
      transition: none;
    }
  }
</style>

<script>
  import { formatEv } from "@/lib/format";

  // The marker reads the light at the middle of the viewport: it interpolates between the
  // measured frames above and below, holds through headings and gaps, and only leaves the
  // scale (∞) once the deep-sky frames take the middle of the screen.
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  const marker = rail?.querySelector<HTMLElement>("[data-rail-marker]");
  const reading = rail?.querySelector<HTMLElement>("[data-rail-reading]");
  if (rail && marker && reading) {
    const top = Number(rail.dataset.top);
    const bottom = Number(rail.dataset.bottom);
    const scale = rail.querySelector<HTMLElement>(".rail__scale")!;
    const frames = [...document.querySelectorAll<HTMLElement>("[data-ev]")].map((el) => ({
      el,
      ev: el.dataset.ev ? Number(el.dataset.ev) : null,
      deep: !!el.closest(".stratum--deep-sky, [data-deep-sky]"),
    }));
    const deepZones = [...document.querySelectorAll<HTMLElement>('[data-ground-zone="deep-sky"], [data-deep-sky]')];
    let last = "";

    const show = (ev: number | null) => {
      const h = scale.clientHeight;
      const y = ev == null ? h + 14 : ((top - Math.max(bottom, Math.min(top, ev))) / (top - bottom)) * h;
      marker.style.setProperty("--marker", `${y}px`);
      const text = ev == null ? "EV — beyond the scale" : formatEv(ev);
      if (text !== last) reading.textContent = last = text;
    };

    const update = () => {
      const mid = innerHeight / 2;
      let above: { y: number; ev: number } | null = null;
      let below: { y: number; ev: number } | null = null;
      let deepAtMid = deepZones.some((z) => {
        const r = z.getBoundingClientRect();
        return r.top < mid && r.bottom > mid;
      });
      for (const f of frames) {
        const r = f.el.getBoundingClientRect();
        if (r.height === 0) continue;
        if (f.deep && r.top < mid && r.bottom > mid) deepAtMid = true;
        if (f.ev == null) continue;
        const y = r.top + r.height / 2;
        if (y <= mid && (!above || y > above.y)) above = { y, ev: f.ev };
        if (y > mid && (!below || y < below.y)) below = { y, ev: f.ev };
      }
      if (deepAtMid) return show(null);
      if (above && below) return show(above.ev + ((mid - above.y) / (below.y - above.y)) * (below.ev - above.ev));
      if (above || below) return show((above ?? below)!.ev);
    };

    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    update();
  }
</script>
