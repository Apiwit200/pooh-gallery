---
import { EV_SCALE } from "@/lib/photos";

const span = EV_SCALE.top - EV_SCALE.bottom;
const ticks = Array.from({ length: span + 1 }, (_, i) => EV_SCALE.top - i);
const pos = (ev: number) => ((EV_SCALE.top - ev) / span) * 100;
---

<aside class="rail" aria-hidden="true" data-rail data-top={EV_SCALE.top} data-bottom={EV_SCALE.bottom}>
  <div class="rail__scale">
    {
      ticks.map((ev) => (
        <span class:list={["rail__tick", { "rail__tick--major": ev % 4 === 0 }]} style={`top:${pos(ev)}%`}>
          {ev % 4 === 0 && <span class="rail__num mono">{ev < 0 ? `−${-ev}` : ev}</span>}
        </span>
      ))
    }
    <span class="rail__beyond mono">∞</span>
    <span class="rail__marker" data-rail-marker></span>
  </div>
  <p class="rail__reading mono" data-rail-reading>EV</p>
</aside>

<style>
  .rail {
    position: fixed;
    z-index: 30;
    top: calc(var(--nav-h) + 1rem);
    bottom: 3.5rem;
    right: 0;
    width: var(--rail);
    pointer-events: none;
    color: var(--fg);
    transition: color 0.9s var(--ease-out-expo);
  }
  .rail__scale {
    position: absolute;
    inset: 0 0 2.75rem 0;
    border-left: 1px solid var(--hair);
    margin-left: 0.25rem;
  }
  .rail__tick {
    position: absolute;
    left: 0;
    width: 0.375rem;
    height: 1px;
    background: var(--hair);
  }
  .rail__tick--major {
    width: 0.75rem;
  }
  .rail__num {
    position: absolute;
    left: 1.1rem;
    top: -0.45rem;
    font-size: 0.625rem;
    color: var(--fg-dim);
    opacity: 0.55;
  }
  .rail__beyond {
    position: absolute;
    left: 1.1rem;
    bottom: -1.6rem;
    font-size: 0.75rem;
    opacity: 0.35;
  }
  .rail__marker {
    position: absolute;
    left: -0.25rem;
    top: 0;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    transform: translateY(var(--marker, -10px));
    transition: transform 0.9s var(--ease-out-expo), opacity 0.4s;
  }
  .rail__reading {
    position: absolute;
    right: 0.5rem;
    bottom: 0;
    width: max-content;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .rail__num {
      display: none;
    }
    .rail {
      width: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail__marker {
      transition: none;
    }
  }
</style>

<script>
  import { formatEv } from "@/lib/format";

  const rail = document.querySelector<HTMLElement>("[data-rail]");
  const marker = rail?.querySelector<HTMLElement>("[data-rail-marker]");
  const reading = rail?.querySelector<HTMLElement>("[data-rail-reading]");
  if (rail && marker && reading) {
    const top = Number(rail.dataset.top);
    const bottom = Number(rail.dataset.bottom);
    const scale = rail.querySelector<HTMLElement>(".rail__scale")!;
    const visible = new Map<Element, IntersectionObserverEntry>();
    let current: Element | null = null;

    const render = (el: Element | null) => {
      if (el === current) return;
      current = el;
      const raw = el?.getAttribute("data-ev");
      const ev = raw ? Number(raw) : null;
      const h = scale.clientHeight;
      const y = ev == null ? h + 14 : ((top - Math.max(bottom, Math.min(top, ev))) / (top - bottom)) * h;
      marker.style.setProperty("--marker", `${y}px`);
      reading.textContent = el ? (ev == null ? "EV — beyond the scale" : formatEv(ev)) : "";
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.set(e.target, e);
          else visible.delete(e.target);
        }
        let best: Element | null = null;
        let bestDist = Infinity;
        const mid = innerHeight / 2;
        for (const el of visible.keys()) {
          const r = el.getBoundingClientRect();
          const d = Math.abs(r.top + r.height / 2 - mid);
          if (d < bestDist) [best, bestDist] = [el, d];
        }
        render(best);
      },
      { rootMargin: "-35% 0px -35% 0px" },
    );
    document.querySelectorAll("[data-ev]").forEach((el) => io.observe(el));
  }
</script>
