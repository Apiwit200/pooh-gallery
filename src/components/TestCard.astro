---
import Ornament from "@/components/Ornament.astro";
import type { Photo } from "@/lib/photos";
import { asset } from "@/lib/photos";

interface Props {
  photo?: Photo | undefined;
  caption: string;
}
const { photo, caption } = Astro.props;
const base = import.meta.env.BASE_URL;
// Seven bars in the site palette, the way an old station shows its colours before the programme.
const bars = ["#f4f4ff", "#bcf015", "#350aff", "#120d2b", "#ebedf5", "#1a0080", "#bcf015"];
---

<figure class="card" aria-label="Test card">
  <div class="card__bars" aria-hidden="true">
    {bars.map((c) => <span style={`background:${c}`}></span>)}
  </div>
  <div class="card__mid" aria-hidden="true">
    <div class="card__circle">
      {photo && <img src={asset(base, photo, 480)} alt="" loading="lazy" decoding="async" />}
      <Ornament size="38%" class="card__mark" />
    </div>
  </div>
  <figcaption class="pixel card__cap">{caption}</figcaption>
</figure>

<style>
  .card {
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto auto;
    aspect-ratio: 4 / 3;
    background: var(--color-ink);
    padding: 0.6rem;
    box-shadow: 0 0 0 1px var(--hair);
  }
  .card__bars {
    grid-row: 1 / 3;
    grid-column: 1;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
  }
  .card__mid {
    grid-row: 1 / 3;
    grid-column: 1;
    display: grid;
    place-items: center;
  }
  .card__circle {
    position: relative;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--color-ink);
    box-shadow: 0 0 0 6px var(--color-ink), 0 0 0 9px var(--color-white);
  }
  .card__circle img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__circle :global(.card__mark) {
    position: relative;
    color: var(--color-lime);
    mix-blend-mode: difference;
  }
  .card__cap {
    grid-row: 3;
    margin: 0.5rem 0 0;
    color: var(--color-lime);
    text-align: center;
  }
</style>
